<?xml version="1.0" encoding="utf-8"?>
<!-- Only merged into the app when cloud backup is built in. Gameplay, engine, recognition and
     voice never use the network; this permission is solely for the optional Firestore backup. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- No analytics or ad tracking: firebase-analytics is not a dependency, and these flags keep
         it off even if a transitive library ever pulls it in. -->
    <application>
        <meta-data android:name="firebase_analytics_collection_deactivated" android:value="true" />
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
        <meta-data android:name="firebase_crashlytics_collection_enabled" android:value="false" />
    </application>
</manifest>
